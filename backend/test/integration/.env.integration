# Loaded automatically during integration tests (see Connection.initialize).
# Override ports when using docker-compose.test.yml (3307 / 6380).
DISABLE_RATE_LIMIT=true
JWT_SECRET=integration-test-jwt-secret-min-32-chars-long
DB_HOST=127.0.0.1
DB_PORT=3307
DB_USER=root
DB_PASSWORD=test
DB_NAME=fs_hub_test
DB_SECURE=false
REDIS_HOST=127.0.0.1
REDIS_PORT=6380
