# Copy to .env and replace ALL placeholder values before docker compose up

DB_NAME=fs_hub_db
DB_USER=root
DB_PASSWORD=change-me-strong-db-password
DB_HOST=database
DB_PORT=3306
# true for MySQL 8+ (caching_sha2_password); false only if using mysql_native_password
DB_SECURE=true

JWT_SECRET=change-me-long-random-jwt-secret-min-32-chars

AI_API_KEY=change-me-long-random-ai-api-key
AI_SERVICE_URL=http://localhost:8001
AI_ALLOW_DEV_KEY=false

CORS_ALLOWED_ORIGIN=http://localhost
API_BASE_URL=http://localhost:8080

BACKEND_PORT=8080
FRONTEND_PORT=80

REDIS_HOST=redis
REDIS_PORT=6379
