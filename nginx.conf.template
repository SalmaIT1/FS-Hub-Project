events {
    worker_connections 1024;
}

http {
    include /etc/nginx/mime.types;
    default_type application/octet-stream;

    server {
        listen 80;
        server_name localhost;
        
        root /usr/share/nginx/html;
        index index.html;
        
        # Flutter web SPA routing
        location / {
            try_files $uri $uri/ /index.html;
        }
        
        # Static asset caching
        location ~* \.(js|css|png|jpg|jpeg|gif|ico|svg|wasm|woff|woff2)$ {
            expires 1y;
            add_header Cache-Control "public, immutable";
        }
        
        # API proxy — forwards /api/* to the backend service.
        # BACKEND_URL is injected at container startup via envsubst.
        # e.g. https://fs-hub-backend.onrender.com
        # The /api/ prefix is stripped before forwarding.
        location /api/ {
            proxy_pass ${BACKEND_URL}/;
            proxy_set_header Host $http_host;
            proxy_set_header X-Real-IP $remote_addr;
            proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
            proxy_set_header X-Forwarded-Proto $scheme;
            proxy_read_timeout 60s;
        }
        
        # Error pages
        error_page 404 /index.html;
        error_page 500 502 503 504 /50x.html;
        location = /50x.html {
            root /usr/share/nginx/html;
        }
    }
}
